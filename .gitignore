# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- agent config (agent-agnostic-template) ---
# Private skills stay on this machine. Their links in .claude/skills/ are kept
# out of git by .agents/scripts/link-skills.sh.
.agents/skills-local/*
!.agents/skills-local/.gitkeep

# Zipped skills from .agents/scripts/package-skill.sh.
.agents/dist/

# Machine-local agent settings and state.
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Local database and browser test output
.data/
.insforge/
playwright-report/
test-results/
!.env.example

.next-e2e/
premium-audit.json
