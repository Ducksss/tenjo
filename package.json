{
  "name": "tenjo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "dev:demo": "TENJO_DEMO_MODE=true next dev --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "demo:seed": "node --import tsx scripts/seed.ts",
    "demo:rehearsal": "node --import tsx scripts/rehearsal.ts",
    "format:check": "prettier --check src scripts tests *.ts *.json README.md DESIGN.md UX-CONTRACT.md docs/*.md",
    "format": "prettier --write src scripts tests *.ts *.json README.md DESIGN.md UX-CONTRACT.md docs/*.md",
    "world:debrief": "node --env-file-if-exists=.env.local --import tsx scripts/debrief.ts",
    "sui:publish": "node --env-file-if-exists=.env.local --import tsx scripts/sui-publish.ts",
    "sui:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/sui-smoke.ts",
    "sui:demo-drop": "node --env-file-if-exists=.env.local --import tsx scripts/sui-demo-drop.ts",
    "sui:test": "sui move test --path move/tenjo"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@mysten/dapp-kit-react": "^2.1.35",
    "@mysten/sui": "^2.33.1",
    "@noble/hashes": "^1.8.0",
    "@worldcoin/idkit": "^4.3.0",
    "@worldcoin/idkit-core": "^4.3.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
