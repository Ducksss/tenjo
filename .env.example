# Canonical public origin on deployment (e.g. https://tenjo.example). Optional locally.
APP_ORIGIN=
# Hosted Postgres; omit locally to use persistent PGlite in .data/tenjo.
DATABASE_URL=
# At least 16 characters. Used only in the Authorization header.
ADMIN_PASSWORD=
# World Developer Portal staging app / RP / fixed action.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ACTION=tenjo-person
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
# Pin one protocol for the entire database. Never flip with existing identities.
WORLD_PROTOCOL=3.0
# passport (default) or orb (explicit fallback)
WORLD_CREDENTIAL=passport
# Only enable for the explicitly labelled staging pickup fallback.
# Production pickup stays disabled pending server-attested liveness integration.
WORLD_ALLOW_UNTESTED_PICKUP=false
# Demo endpoints require this flag, non-production, and localhost.
TENJO_DEMO_MODE=false

# Optional ISO timestamp for measured integration debrief.
WORLD_INTEGRATION_STARTED_AT=
