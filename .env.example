# Canonical public origin on deployment (e.g. https://tenjo.example). Optional locally.
APP_ORIGIN=
# Hosted Postgres; omit locally to use persistent PGlite in .data/tenjo.
DATABASE_URL=
# At least 16 characters. Used only in the Authorization header.
ADMIN_PASSWORD=
# World Developer Portal staging app / RP / fixed action.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_ACTION=tenjo-person
WORLD_RP_SIGNING_KEY=
WORLD_ENVIRONMENT=staging
# World verifies staging proofs only inside a 24-hour window. npm run world:staging-window
# opens one with a Developer Portal API key and writes this token.
WORLD_STAGING_VERIFICATION_TOKEN=
# Pin one protocol for the entire database. Never flip with existing identities.
WORLD_PROTOCOL=3.0
# passport (default) or orb (explicit fallback)
WORLD_CREDENTIAL=passport
# Only enable for the explicitly labelled staging pickup fallback.
# Production pickup stays disabled pending server-attested liveness integration.
WORLD_ALLOW_UNTESTED_PICKUP=false
# Optional: real World IDs beside the staging simulator. A production app / RP / signing key;
# entries then default to the phone's World App and the simulator stays one click away.
# Protocol 4.0; credential orb (Proof of Human, default) or passport. Pickup stays on the primary setup.
WORLD_PRODUCTION_APP_ID=
WORLD_PRODUCTION_RP_ID=
WORLD_PRODUCTION_RP_SIGNING_KEY=
WORLD_PRODUCTION_ACTION=
WORLD_PRODUCTION_CREDENTIAL=orb
# Demo endpoints require this flag, non-production, and localhost.
TENJO_DEMO_MODE=false

# Optional ISO timestamp for measured integration debrief.
WORLD_INTEGRATION_STARTED_AT=

# Sui (docs/OPERATIONS.md, "Sui"). Server-only. Sui turns on only when the package, the
# OrganiserCap and the organiser key are all set; otherwise every drop uses the server draw.
SUI_NETWORK=testnet
# Optional gRPC endpoint; defaults to https://fullnode.<network>.sui.io:443.
SUI_RPC_URL=
# Printed by npm run sui:publish.
SUI_PACKAGE_ID=
SUI_ORGANISER_CAP_ID=
# Organiser key, bech32 suiprivkey… (Ed25519): sui keytool export --key-identity <alias>
SUI_SECRET_KEY=
# Optional: a separate Ed25519 key that signs entry permits (defaults to the organiser key).
SUI_REGISTRAR_SECRET_KEY=
# Optional: receives the winners' deposits (defaults to the organiser address).
SUI_PAYOUT_ADDRESS=
